<Project Sdk="WixToolset.Sdk/4.0.6">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>SmartLang.v$(SmartLangVersion)</OutputName>
    <DefineConstants>$(DefineConstants);PublishDir=$(PublishDir);ProductVersion=$(SmartLangVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
  </ItemGroup>

</Project>
